<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    <ul>
        <% projects.forEach(project => { %>
            <li>
                <strong><%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %>:</strong> 
                <%= project.title %> (<%= project.organization_name %>)
                <br>
                <em>Location:</em> <%= project.location %>
                <br>
                <p><%= project.description %></p>
            </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>